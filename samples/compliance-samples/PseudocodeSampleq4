BEGIN
  SET LED_PIN = output
  SET THRESHOLD = 30 degrees Celsius


  LOOP forever:
    Raw =  analogRead(TEMP_PIN)
    voltage =  (raw / 1023) × 5.0
    Temp_c =  (voltage − 0.5) × 100


    PRINT temp_c to serial monitor


    IF temp_c >= THRESHOLD THEN
        turn LED ON       // temperature too high
    ELSE
        turn LED OFF      // temperature normal
    END IF


    wait 1000ms
  END LOOP
END
